{
  "name": "camelai-free-tier",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:local-auth": "LOCAL_AUTH_BYPASS=1 WORKER_BASE_URL=http://localhost:3001 react-router dev",
    "build": "bun run build:cf",
    "build:cf": "bun run build:renderer && react-router build",
    "start": "node scripts/wrangler-dev.mjs",
    "typecheck": "react-router typegen && tsc --incremental --tsBuildInfoFile node_modules/.cache/chiridion-typecheck.tsbuildinfo && tsc -p workers/app-usage-guard/tsconfig.json --noEmit",
    "lint": "bun run check:runtime-lucide-imports && bun run lint:source",
    "lint:source": "oxlint src workers/main/src workers/discord-bridge/src workers/dispatcher/src workers/user-logs-tail/src workers/app-usage-guard/src scripts sandbox/create-worker/renderer sandbox/create-worker/templates/starter workers/main/db-query-sandbox-assets/runner -A all -D no-unused-vars",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:discord-bridge": "vitest run --config vitest.discord-bridge.config.ts",
    "free:dev": "bun run dev:local-auth",
    "free:build": "bun run build:cf",
    "free:deploy": "wrangler deploy --env free",
    "free:start": "node scripts/wrangler-dev.mjs --env free",
    
    # Simplified deploy scripts - removed complex container/queue deployments
    "deploy:free:main": "node scripts/deploy-main.mjs free",
    "deploy:free": "wrangler deploy --env free",
    
    # Removed heavy-duty tests for free tier
    "test:all": "bun run test:run",
    "typecheck:minimal": "tsc --noEmit --noUnusedLocals --noUnusedParameters --incremental false",
    
    # Free tier specific
    "free:config": "echo 'Free tier configuration active - R2, containers, queues disabled'",
    "free:limits": "echo 'Daily requests: 100,000 (reset midnight UTC)'",
    "free:info": "echo 'camelAI Free Tier - Personal use only. No R2, No containers, No queues.'"
  },
  "dependencies": {
    "@camelai/run": "0.17.0",
    "@cloudflare/dynamic-workflows": "^0.1.1",
    "@cloudflare/puppeteer": "^1.0.6",
    "@cloudflare/sandbox": "1.0.0",
    "@cloudflare/shell": "0.3.7",
    "@cloudflare/vite-plugin": "1.62.3",
    "@conform-to/react": "^1.15.1",
    "@conform-to/zod": "^1.15.1",
    "@earendil-works/pi-ai": "1.1.0",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-pdf/renderer": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "8.0.4",
    "emoji-regex": "^10.6.0",
    "emojibase-data": "^17.0.0",
    "flubber": "^0.4.2",
    "hono": "^4.12.3",
    "hono-zod-openapi": "^1.1.1",
    "isbot": "^5.1.17",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "openid-client": "6.8.4",
    "postal-mime": "^2.7.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.1.1",
    "react-router": "^7.16.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "shiki": "^3.20.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "typebox": "1.1.38",
    "unified": "^11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^4.20260605.1",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.16.0",
    "@tailwindcss/postfix": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.3.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "vite": "$vite"
  }
}