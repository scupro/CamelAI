{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Free Tier 版：僅保留 D1 + KV + AI + Durable Objects
  // 已移除：containers（付費）、R2、queues、analytics_engine、browser、images、
  //        worker_loaders、send_email、tail_consumers、observability、workflows
  //
  // R2 特別說明：R2 有免費額度（10 GB-month／100 萬 Class A／1000 萬 Class B），
  // 但「啟用」必須先登記信用卡，且免費額度是計費門檻而非硬限制（超出即扣費）。
  // 為了維持「不需信用卡、不會被扣費」，這裡刻意不宣告任何 r2_buckets 綁定，
  // 因此執行期 env.R2_BUCKET 恆為 undefined；所有存取點皆已加守卫，回 501/ENOR2
  // 或略過，不會 crash。詳見 README「為什麼不綁 R2」。
  "name": "camelai",
  "main": "workers/main/src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "vars": {},
  // 面板「Variables and secrets」的字串變數與 secrets 不會被每次部署覆蓋
  // （wrangler 預設會以本檔 vars 覆寫面板設定，見官方 docs「Source of truth」）
  "keep_vars": true,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // KV / D1 只宣告 binding 名稱、**不寫 resource id**（Automatic provisioning）：
  // 部署時 wrangler 自動建立資源；透過 GitHub／面板部署時實際 id 只存在面板
  // Settings → Bindings，不會寫回這份檔案，因此 repo 內不保留任何 id。
  "kv_namespaces": [
    { "binding": "SESSIONS" },
    { "binding": "APP_KV" },
    { "binding": "EMAIL_TO_USER" }
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "camelai-db",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "SIGNUP", "class_name": "SignupDO" },
      { "name": "ORG", "class_name": "OrgDO" },
      { "name": "EMAIL_HANDLE", "class_name": "EmailHandleDO" },
      { "name": "TELEGRAM_REGISTRY", "class_name": "TelegramRegistryDO" },
      { "name": "SLACK_TEAM_REGISTRY", "class_name": "SlackTeamRegistryDO" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "WORKSPACE_CRON", "class_name": "WorkspaceCronDO" },
      { "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" },
      { "name": "WORKSPACE_FS", "class_name": "WorkspaceFilesystemDO" }
    ]
  },
  // 全新部署（無既有 DO 狀態），以單一新 tag 宣告所有類別
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatThreadDO",
        "UserDO",
        "SignupDO",
        "OrgDO",
        "EmailHandleDO",
        "TelegramRegistryDO",
        "SlackTeamRegistryDO",
        "WorkspaceDO",
        "WorkspaceCronDO",
        "WorkerLogsDO",
        "WorkspaceFilesystemDO"
      ]
    }
  ]
}
