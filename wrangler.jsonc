{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "CamelAI",
  "main": "workers/main/src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "vars": {},
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "f5ab08fdb1d7404fbc45a171217b4a27"
    },
    {
      "binding": "APP_KV",
      "id": "e894eb2caf1641ad8870da994b992fce"
    },
    {
      "binding": "EMAIL_TO_USER",
      "id": "ab267c4f44b847dda8bdca400a4e1884"
    }
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "camelai-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [],
    "consumers": []
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_THREAD",
        "class_name": "ChatThreadDO"
      },
      {
        "name": "USER",
        "class_name": "UserDO"
      },
      {
        "name": "WORKSPACE_FS",
        "class_name": "WorkspaceFilesystemDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatDurableObject"]
    }
  ]
}
